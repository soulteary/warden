# Warden 环境变量配置示例
# 
# 使用说明：
# 1. 复制此文件为 .env: cp .env.example .env
# 2. 根据实际情况填写各项配置值
# 3. 不要将 .env 文件提交到版本控制系统
#
# 注意：敏感信息（如 API keys、密码等）应使用环境变量，不要硬编码在代码中

# 服务器配置
PORT=8081

# Redis 配置
REDIS=warden-redis:6379
# 是否启用 Redis（可选，默认 true；ONLY_LOCAL 且未设 REDIS 时默认 false）
# REDIS_ENABLED=true
# Redis 密码（可选，建议使用环境变量而不是配置文件）
# REDIS_PASSWORD=your-redis-password
# 或使用密码文件（更安全）；整体优先级：REDIS_PASSWORD > REDIS_PASSWORD_FILE > 配置文件
# REDIS_PASSWORD_FILE=/path/to/redis-password.txt

# 远程配置 API（默认 Compose 使用本地数据；启用远程来源时还必须配置加密信封）
CONFIG=
# 远程配置 API 认证密钥
KEY=

# 任务配置
INTERVAL=5

# 部署环境与数据合并模式（推荐使用下面两个新变量，替代已弃用的 MODE）
# ENVIRONMENT 决定安全硬化与生产认证要求；MERGE_MODE 决定数据来源合并/回退策略。
# 详见 docs/migration-config.md
# ENVIRONMENT 可选值: development, test, production（应用默认 development；Compose 默认 production）
ENVIRONMENT=production
# MERGE_MODE 可选值: DEFAULT, REMOTE_FIRST, ONLY_REMOTE, ONLY_LOCAL, LOCAL_FIRST,
#            REMOTE_FIRST_ALLOW_REMOTE_FAILED, LOCAL_FIRST_ALLOW_REMOTE_FAILED
MERGE_MODE=ONLY_LOCAL
#
# 已弃用：MODE 现仅作为 MERGE_MODE 的别名（不再用于生产判断）；与新变量冲突时新变量生效。
# MODE=DEFAULT

# HTTP 客户端配置（可选）
# HTTP_TIMEOUT=5
# HTTP_MAX_IDLE_CONNS=100
# HTTP_INSECURE_TLS=false

# 本地用户数据文件路径（默认: ./data.json）
# DATA_FILE=./data.json
# 本地用户数据目录（可选）：合并该目录下所有 *.json，可与 DATA_FILE 同时使用
# DATA_DIR=/path/to/data/dir

# API 响应字段白名单（可选，逗号分隔；空=返回全部）。如 phone,mail,user_id,status,scope,role,name
# RESPONSE_FIELDS=

# 远程 API 加密响应解密（可选）
# REMOTE_DECRYPT_ENABLED=false
# REMOTE_RSA_PRIVATE_KEY_FILE=/path/to/private.pem
# 或使用内联 PEM（未设置 FILE 时生效）；建议使用密钥管理器注入：REMOTE_RSA_PRIVATE_KEY=<set-via-secret-manager>
# REMOTE_RSA_PRIVATE_KEY=
# 认证信封 v2（AES-256-GCM + RSA-OAEP-SHA256），详见 docs/migration-encryption-v2.md
# 可接受的格式: auto|v2|legacy（默认 auto，迁移期同时接受新旧格式）
# Production remote sources must use v2. auto/legacy are migration-only.
# REMOTE_ENCRYPTION_FORMAT=v2
# 生产建议 fail closed：拒绝无法解密的明文响应
# Requires REMOTE_DECRYPT_ENABLED=true and one RSA private key setting above.
# REMOTE_ENCRYPTION_REQUIRED=true

# 身份完整性（可选，详见 docs/migration-config.md）
# 缺少显式 user_id 时拒绝该记录（而不是静默派生）
# REQUIRE_EXPLICIT_USER_ID=false
# user_id 派生策略: legacy（历史 16 位摘要，输出迁移警告）| sha256-128（域分离 SHA-256 128bit）
# USER_ID_STRATEGY=legacy

# API Key（用于 API 认证；默认 Compose 启动前必须填写，且仅与内部调用方共享）
API_KEY=

# 配置文件路径（可选；用于在不使用 --config-file 时从 YAML 加载 tracing 等）
# CONFIG_FILE=config.yaml

# OpenTelemetry 追踪（可选）
# OTLP_ENABLED=false
# OTLP_ENDPOINT=http://localhost:4318

# 日志级别（可选: trace, debug, info, warn, error, fatal, panic）
# LOG_LEVEL=info

# 健康检查 IP 白名单（可选，逗号分隔，支持 CIDR）
# HEALTH_CHECK_IP_WHITELIST=127.0.0.1,::1,10.0.0.0/8

# 全局 IP 白名单（可选，逗号分隔，支持 CIDR）
# IP_WHITELIST=192.168.1.0/24

# 信任的代理 IP 列表（可选，逗号分隔，用于反向代理环境）
# TRUSTED_PROXY_IPS=127.0.0.1,10.0.0.1

# 服务间鉴权（仅环境变量，无 YAML 配置项）
# 生产环境（ENVIRONMENT=production）必须至少配置以下之一：API_KEY / WARDEN_HMAC_KEYS / mTLS，否则启动失败
# HMAC 同时支持 v1 与认证 v2（v2 带 per-request nonce + 防重放）；密钥请使用密钥管理器注入
# WARDEN_HMAC_KEYS='{"key-id":"<set-via-secret-manager>"}'
# 是否继续接受旧版 v1 签名；迁移完成后设为 false，仅接受带 nonce 的 v2
# WARDEN_HMAC_ALLOW_V1=true
# 时间戳容差（秒，含上限），默认 60
# WARDEN_HMAC_TIMESTAMP_TOLERANCE=60
# WARDEN_TLS_CERT=/path/to/warden.crt
# WARDEN_TLS_KEY=/path/to/warden.key
# WARDEN_TLS_CA=/path/to/ca.crt
# WARDEN_TLS_REQUIRE_CLIENT_CERT=true

# /metrics 暴露（可选）：默认匿名暴露、仅低基数非敏感指标；设为 true 则对 /metrics 强制认证
# WARDEN_METRICS_REQUIRE_AUTH=false
