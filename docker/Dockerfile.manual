# syntax=docker/dockerfile:1
#
# 手动/国内网络镜像：多阶段构建，使用清华镜像源，运行阶段以非 root 用户运行。
# 与 docker/Dockerfile 语义一致，仅额外配置 APK/GOPROXY 镜像源与时区。

# 高保证：将 tag 追加 @sha256:<digest> 以固定不可变镜像。
FROM golang:1.26.6-alpine3.23 AS builder
RUN echo '' > /etc/apk/repositories && \
    echo "https://mirror.tuna.tsinghua.edu.cn/alpine/v3.23/main"         >> /etc/apk/repositories && \
    echo "https://mirror.tuna.tsinghua.edu.cn/alpine/v3.23/community"    >> /etc/apk/repositories && \
    echo "Asia/Shanghai" > /etc/timezone
RUN apk add --no-cache git bash gcc musl-dev upx tzdata
ENV TZ=Asia/Shanghai
WORKDIR /app
ENV GO111MODULE=on
ENV GOPROXY=https://goproxy.cn
COPY go.mod .
COPY go.sum .
RUN go mod download

COPY . .

# 定义构建参数，提供默认值以支持本地构建
ARG VERSION=dev
ARG COMMIT=unknown
ARG BUILD_DATE

# UPX 默认关闭；需要时显式开启：--build-arg ENABLE_UPX=1
ARG ENABLE_UPX=0

# 多平台：TARGETOS/TARGETARCH 由 Docker Buildx 注入；本地 build 时用当前内核架构，避免 exec format error（如 ARM Mac）
ARG TARGETOS
ARG TARGETARCH
RUN BUILD_DATE=${BUILD_DATE:-$(date +%FT%T%z)} && \
    ARCH=${TARGETARCH:-$(uname -m | sed 's/x86_64/amd64/;s/aarch64/arm64/;s/armv7l/arm/')} && \
    OS=${TARGETOS:-linux} && \
    GO111MODULE=on GOOS=$OS GOARCH=$ARCH CGO_ENABLED=0 go build \
    -trimpath \
    -ldflags "-w -s -X github.com/soulteary/version-kit.Version=$VERSION -X github.com/soulteary/version-kit.Commit=$COMMIT -X github.com/soulteary/version-kit.BuildDate=$BUILD_DATE" \
    -o warden .

# UPX 压缩仅在 ENABLE_UPX=1 时执行；失败则跳过以保证多平台构建兼容性。
RUN if [ "$ENABLE_UPX" = "1" ] && command -v upx > /dev/null 2>&1; then \
      upx -9 -o warden.minify warden 2>/dev/null && mv warden.minify warden || true; \
    fi


FROM alpine:3.24
ENV TZ=Asia/Shanghai
RUN sed -i 's/dl-cdn.alpinelinux.org/mirrors.tuna.tsinghua.edu.cn/g' /etc/apk/repositories && \
    apk add --no-cache tzdata curl ca-certificates && \
    cp /usr/share/zoneinfo/$TZ /etc/localtime && echo $TZ > /etc/timezone && \
    rm -rf /var/cache/apk/*

# 运行阶段以非 root 用户运行。
RUN addgroup -g 10001 -S warden && \
    adduser -u 10001 -S -G warden -H -s /sbin/nologin warden

COPY --from=builder /app/warden /bin/warden

WORKDIR /app
USER 10001:10001
CMD ["warden"]
